datos_correlacion <- datos_macro %>%
select(
crecimiento_pbi,
inflacion,
desempleo,
crecimiento_inversion,
crecimiento_exportaciones,
variacion_tipo_cambio
)
correlaciones <- cor(
datos_correlacion,
use = "complete.obs"
)
round(correlaciones, 2)
View(correlaciones)
# Creamos una base solo con las variables del modelo
datos_modelo <- datos_macro %>%
select(
crecimiento_pbi,
inflacion,
desempleo,
crecimiento_inversion,
crecimiento_exportaciones,
variacion_tipo_cambio
) %>%
drop_na()
# Ver cuántas observaciones entran efectivamente al modelo
nrow(datos_modelo)
modelo <- lm(
crecimiento_pbi ~
inflacion +
desempleo +
crecimiento_inversion +
crecimiento_exportaciones +
variacion_tipo_cambio,
data = datos_modelo
)
# Ver resultados
summary(modelo)
modelo <- lm(
crecimiento_pbi ~
inflacion +
desempleo +
crecimiento_inversion +
crecimiento_exportaciones +
variacion_tipo_cambio,
data = datos_modelo
)
# Ver resultados
summary(modelo)
# Gráficos de diagnóstico
par(mfrow = c(2, 2))
plot(modelo)
# Gráficos de diagnóstico
par(mfrow = c(2, 2))
plot(modelo)
par(mfrow = c(1, 1))
summary(modelo)
# 2. Multicolinealidad
install.packages("car")   # solo si no lo tenés instalado
# 2. Multicolinealidad
library(car)
vif(modelo)
# 3. Heterocedasticidad
install.packages("lmtest")   # solo si no lo tenés instalado
library(lmtest)
bptest(modelo)
# 4. Autocorrelación de residuos
dwtest(modelo)
