install.packages("readxl")
library(readxl) #para leer archivo de excel
# Ruta del archivo
ruta_excel <- "C:/Users/Usuario/OneDrive/Documentos/GitHub/proyecto/BCU_datos.xlsx"
datos_bcu <- read_excel(
ruta_excel,
sheet = "Valores_K", #la hoja que queremos leer
skip = 7 #ignorar las primeras 7 filas, no nos sirve
)
# Ver los datos
View(datos_bcu)
## Ordenamos los datos:
library(dplyr) #para filtrar, seleccionar, ordenar y transformar
library(tidyr) #para cambiar la forma de la tabla y que quede mejor
# Renombramos la segunda columna como "variable"
names(datos_bcu)[2] <- "variable"
datos_largos <- datos_bcu %>%
pivot_longer(
cols = starts_with(c("I ", "II ", "III ", "IV ")),
names_to = "trimestre",
values_to = "valor"
) #mas comodo para analizar
View(datos_largos)
## Nos quedamos con las variables que nos interesan
# necesitamos: PBI, formación bruta de capital, exportaciones e importaciones
names(datos_largos) #ver bien como se llaman
datos_macro <- datos_largos %>%
variable %in% c(
"Formación Bruta de Capital",
"(-) Importaciones de bienes y servicios"
View(datos_macro)
datos_macro <- datos_largos %>%
filter(
variable %in% c(
"PRODUCTO INTERNO BRUTO",
"Formación Bruta de Capital",
"Exportaciones de bienes y servicios",
"(-) Importaciones de bienes y servicios"
))
View(datos_macro)
#ponemos cada variable como columna
datos_macro <- datos_macro %>%
select(variable, trimestre, valor) %>%
pivot_wider(
names_from = variable,
values_from = valor
)
View(datos_macro)
