# Ruta del archivo
ruta_excel <- "C:/Users/Usuario/OneDrive/Documentos/GitHub/proyecto/BCU_datos.xlsx"
datos_bcu <- read_excel(
ruta_excel,
sheet = "Valores_K",
skip = 7
)
# Ver los datos
View(datos_bcu)
#Ordenamos los datos:
library(dplyr)
library(tidyr)
datos_largos <- datos_bcu %>%
pivot_longer(
cols = starts_with(c("I ", "II ", "III ", "IV ")),
names_to = "trimestre",
values_to = "valor"
)
View(datos_largos)
## Nos quedamos con las variables que nos interesan
# necesitamos: PBI, formación bruta de capital, exportaciones e importaciones
datos_macro <- datos_largos %>%
filter(
...3 %in% c(
"PRODUCTO INTERNO BRUTO",
"Formación Bruta de Capital",
"Exportaciones de bienes y servicios",
"(-) Importaciones de bienes y servicios"
)
)
View(datos_macro)
#ponemos cada variable como columna
datos_macro <- datos_macro %>%
select(...3, trimestre, valor) %>%
pivot_wider(
names_from = ...3,
values_from = valor
)
View(datos_macro)
head(datos_macro)
