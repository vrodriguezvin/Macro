## 5. VARIABLES DE RESUMEN
# ==============================================================
library(ggplot2)
resumen_macro <- datos_macro %>%
summarise(
crecimiento_pbi_media = mean(crecimiento_pbi, na.rm = TRUE),
crecimiento_pbi_mediana = median(crecimiento_pbi, na.rm = TRUE),
crecimiento_pbi_sd = sd(crecimiento_pbi, na.rm = TRUE),
crecimiento_pbi_min = min(crecimiento_pbi, na.rm = TRUE),
crecimiento_pbi_max = max(crecimiento_pbi, na.rm = TRUE),
inflacion_media = mean(inflacion, na.rm = TRUE),
inflacion_mediana = median(inflacion, na.rm = TRUE),
inflacion_sd = sd(inflacion, na.rm = TRUE),
inflacion_min = min(inflacion, na.rm = TRUE),
inflacion_max = max(inflacion, na.rm = TRUE),
desempleo_media = mean(desempleo, na.rm = TRUE),
desempleo_mediana = median(desempleo, na.rm = TRUE),
desempleo_sd = sd(desempleo, na.rm = TRUE),
desempleo_min = min(desempleo, na.rm = TRUE),
desempleo_max = max(desempleo, na.rm = TRUE),
inversion_media = mean(crecimiento_inversion, na.rm = TRUE),
inversion_mediana = median(crecimiento_inversion, na.rm = TRUE),
inversion_sd = sd(crecimiento_inversion, na.rm = TRUE),
exportaciones_media = mean(crecimiento_exportaciones, na.rm = TRUE),
exportaciones_mediana = median(crecimiento_exportaciones, na.rm = TRUE),
exportaciones_sd = sd(crecimiento_exportaciones, na.rm = TRUE),
tipo_cambio_media = mean(variacion_tipo_cambio, na.rm = TRUE),
tipo_cambio_mediana = median(variacion_tipo_cambio, na.rm = TRUE),
tipo_cambio_sd = sd(variacion_tipo_cambio, na.rm = TRUE)
)
View(resumen_macro)
resumen_variables <- datos_macro %>%
select(
crecimiento_pbi,
inflacion,
desempleo,
crecimiento_inversion,
crecimiento_exportaciones,
variacion_tipo_cambio
) %>%
summarise(
across(
everything(),
list(
media = ~ mean(.x, na.rm = TRUE),
mediana = ~ median(.x, na.rm = TRUE),
sd = ~ sd(.x, na.rm = TRUE),
min = ~ min(.x, na.rm = TRUE),
max = ~ max(.x, na.rm = TRUE)
)
)
)
View(resumen_variables)
library(ggplot2)
resumen_variables <- datos_macro %>%
select(
crecimiento_pbi,
inflacion,
desempleo,
crecimiento_inversion,
crecimiento_exportaciones,
variacion_tipo_cambio
) %>%
pivot_longer(
cols = everything(),
names_to = "variable",
values_to = "valor"
) %>%
group_by(variable) %>%
summarise(
media = mean(valor, na.rm = TRUE),
mediana = median(valor, na.rm = TRUE),
desvio = sd(valor, na.rm = TRUE),
minimo = min(valor, na.rm = TRUE),
maximo = max(valor, na.rm = TRUE)
)
View(resumen_variables)
datos_macro <- datos_macro %>%
mutate(
fecha = as.Date(
paste0(
año,
"-",
case_when(
trimestre_num == 1 ~ "01-01",
trimestre_num == 2 ~ "04-01",
trimestre_num == 3 ~ "07-01",
trimestre_num == 4 ~ "10-01"
)
)
)
)
